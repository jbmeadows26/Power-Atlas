  "metrics": [
    {
      "id": "efficiency_gap",
      "family": "partisan",
      "definition": "(Democratic wasted votes - Republican wasted votes)/all two-party votes",
      "prerequisites": [
        "district_votes_same_election_stage_year_and_plan",
        "complete_and_validated_two_party_district_returns",
        "uncontested_handling_and_turnout_review",
        "official_canvass_reconciled"
      ],
      "calculationStatus": "blocked_by_unreconciled_certification",
      "warning": "No 7-8% threshold determines illegality; sign convention and elections included must be shown."
    },
    {
      "id": "mean_median",
      "family": "partisan",
      "definition": "median of district Democratic two-party vote shares minus unweighted mean",
      "prerequisites": [
        "complete_validated_two_party_district_vote_shares",
        "documented_uncontested_imputation_policy",
        "certified_and_vintage_aligned_returns"
      ],
      "calculationStatus": "blocked_by_unreconciled_certification",
      "warning": "Unweighted district mean is not statewide popular vote; turnout variation and uncontested races affect interpretation."
    },
    {
      "id": "declination",
      "family": "partisan",
      "definition": "Angular asymmetry statistic from sorted two-party district vote shares using winning and losing district subsets",
      "prerequisites": [
        "at_least_one_seat_won_by_each_party",
        "validated_complete_district_vote_shares",
        "specified_version_and_treatment_of_ties"
      ],
      "calculationStatus": "not_implemented_input_gate",
      "warning": "Undefined in one-party sweeps; do not substitute seat-vote gaps."
    },
    {
      "id": "partisan_bias",
      "family": "partisan",
      "definition": "Predicted seat difference under tied statewide vote using a disclosed uniform-swing or simulation model",
      "prerequisites": [
        "multiple_election_model_and_version",
        "validated_precinct_vote_history",
        "map_and_boundary_alignment",
        "uncertainty_intervals"
      ],
      "calculationStatus": "requires_model_outputs",
      "warning": "Not derivable from the raw seat-minus-vote share statistic."
    },
    {
      "id": "polsby_popper",
      "family": "geometric",
      "definition": "4π×district area / squared district perimeter",
      "prerequisites": [
        "full_resolution_authoritative_district_geometry",
        "valid_projected_area_and_perimeter_units",
        "topology_validation"
      ],
      "calculationStatus": "blocked_by_generalized_maps",
      "warning": "Never compute from 1:20m generalized boundary coordinates in latitude/longitude degrees."
    },
    {
      "id": "reock",
      "family": "geometric",
      "definition": "Area of district divided by area of minimum enclosing circle",
      "prerequisites": [
        "full_resolution_geometry",
        "consistent_equal_area_projection",
        "validated_minimum_enclosing_circle"
      ],
      "calculationStatus": "not_implemented_input_gate"
    },
    {
      "id": "convex_hull",
      "family": "geometric",
      "definition": "Area of district divided by area of its convex hull",
      "prerequisites": [
        "full_resolution_geometry",
        "equal_area_projection",
        "complete_multipart_handling"
      ],
      "calculationStatus": "not_implemented_input_gate"
    },
    {
      "id": "ensemble_outlier",
      "family": "counterfactual",
      "definition": "Observed plan's position in legally constrained, sampled map-plan distribution",
      "prerequisites": [
        "block_population_and_CVAP",
        "VTD_or_block_adjacency",
        "legal_map_constraints_by_state_and_year",
        "seeded_multiple_independent_chains",
        "stationarity_and_effective_sample_size",
        "enacted_map_and_sample_plan_comparison"
      ],
      "calculationStatus": "no_valid_ensemble_available",
      "warning": "Not equivalent to a p-value or a legal finding without justified null model."
    },
    {
      "id": "VRA_section2_racial_vote_dilution",
      "family": "legal_demographic",
      "definition": "Legal and contextual analysis under updated Gingles framework and 2026 Callais decision",
      "prerequisites": [
        "versioned_legal_standard_as_of_claim_date",
        "full_precinct_race_and_turnout_evidence",
        "racial_bloc_voting_analysis_controlling_for_partisanship",
        "comparator_maps_meeting_other_legitimate_state_objectives",
        "individual_court_findings"
      ],
      "calculationStatus": "legal_analysis_not_automated_score",
      "warning": "Race and party should not be inferred from names or coarse district demographics; demographic differences do not automatically prove unlawful discrimination."
    }
  ],
  "policy": {
    "redistrictingOutcomeIsNotSingleMetric": true,
    "thresholdIsNotLegalFinding": true,
    "legalBaseline2026": "Louisiana v. Callais, 2026-04-29; Allen v. Milligan 2023 remains part of precedent but was clarified",
    "requireOfficialResultsForVerifiedVoteLabels": true,
    "requireMapVersionAndElectionPeriod": true,
    "doNotInferIndividualIntentFromScores": true,
    "licensing": "No authenticated APIs or dataset rehosting without permission, approval and rights"
  }
}
